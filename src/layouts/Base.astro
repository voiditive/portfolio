---
import '@fontsource-variable/league-spartan';
import '@fontsource-variable/montserrat';
import '@fontsource/arimo/400.css';
import '@fontsource/arimo/700.css';
import '../styles/tokens.css';
import { getCollection, getEntry } from 'astro:content';
import Nav from '../components/Nav.astro';
import { navItems } from '../lib/nav';

interface Props {
	title: string;
	description: string;
	/** The nav href of this page: "/" for home, "/pipboy" and so on. */
	current: string;
}

const { title, description, current } = Astro.props;
const projects = await getCollection('projects');
const illustrations = await getEntry('illustrations', 'illustrations');
const items = navItems(
	projects.map((p) => ({ slug: p.id, navLabel: p.data.navLabel, order: p.data.order })),
	illustrations!.data,
);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
		<!-- Futura PT (Book, Medium, Demi, Extra Bold) from Drew's Adobe Fonts web project. -->
		<link rel="preconnect" href="https://use.typekit.net" crossorigin />
		<link rel="stylesheet" href="https://use.typekit.net/ruh1bpa.css" />
	</head>
	<body>
		<a id="top"></a>
		<Nav items={items} current={current} />
		<main>
			<slot />
		</main>
	</body>
</html>
