---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CanvaPage from '../components/CanvaPage.astro';

const illustrations = (await getEntry('illustrations', 'illustrations'))!.data;
---

<Base
	title="Illustrations, sketches and studies · Andrew Matthew Uy"
	description="Illustrations, art studies, sketches, concepts and experiments by Andrew Matthew Uy."
	current="/illustrations"
>
	<CanvaPage sections={illustrations.sections} current="/illustrations" />
</Base>
