// Cloudflare Workers serves the static build; there is no Worker code.
// The name must match the Worker's name in the Cloudflare dashboard.
{
	"name": "portfolio",
	"compatibility_date": "2026-10-25",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		// Site links have no trailing slash (/pipboy): serve them directly instead of redirecting.
		"html_handling": "drop-trailing-slash"
	}
}
