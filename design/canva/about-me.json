   "h": 173.3,
   "runs": [
    {
     "text": "I’m 21 years old, currently studying Industrial Design at De La Salle-College of Saint Benilde. I enjoy turning ideas into meaningful products and experiences through sketching, illustration, 3D modeling, and experimentation.\n \nI believe",
     "size": 17.1,
     "weight": "normal",
     "color": "#1e1e1e",
     "align": "justify",
     "lh": 1,
     "ls": -0.02,
     "font": "YAFcfgcNhWk,3"
    },
    {
     "text": " ",
     "size": 17.1,
     "weight": "bold",
     "color": "#1e1e1e",
     "align": "justify",
     "lh": 1,
     "ls": -0.02,
     "font": "YAFcfgcNhWk,3"
    },
    {
     "text": "that",
     "size": 17.1,
     "weight": "normal",
     "color": "#1e1e1e",
     "align": "justify",
     "lh": 1,
     "ls": -0.02,
     "font": "YAFcfgcNhWk,3"
    },
    {
     "text": " to design is to serve",
     "size": 17.1,
     "weight": "bold",
     "color": "#1e1e1e",
     "align": "justify",
     "lh": 1,
     "ls": -0.02,
     "font": "YAFcfgcNhWk,3"
    },
    {
     "text": "—to understand people, solve problems, and create things that are purposeful and enjoyable.\n",
     "size": 17.1,
     "weight": "normal",
     "color": "#1e1e1e",
     "align": "justify",
     "lh": 1,
     "ls": -0.02,
     "font": "YAFcfgcNhWk,3"
    },
    {
     "text": "\n",
     "size": 17.1,
     "weight": "normal",
     "color": "#1e1e1e",
     "align": "justify",
     "lh": 1,
     "ls": -0.02,
     "font": "YAFcfgcNhWk,3"
    }
   ]
