   "h": 194.7,
   "runs": [
    {
     "text": "ISHDA is a playful yet thoughtful utensils brand that blends function with storytelling. Inspired by the fish—an everyday symbol of food, culture, and nourishment—its packaging becomes part of the product itself. Each utensil is revealed through the fish’s tail, forming a spoon, fork, or knife, turning a simple dining tool into a memorable experience. ISHDA highlights creativity, sustainability, and local inspiration by transforming ordinary utensils into objects that feel intentional, engaging, and visually distinctive.",
     "size": 18.1,
     "weight": "normal",
     "color": "#1e1e1e",
     "align": "justify",
     "lh": 1,
     "ls": -0.02,
     "font": "YAFcfgcNhWk,3"
    }
   ]
